# ============================================================
# Saachi Crochet Corner — environment variables
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to source control.
# ============================================================

# --- Database (PostgreSQL + Prisma) ---
DATABASE_URL="postgresql://user:password@localhost:5432/saachi_crochet_corner"

# --- Auth ---
JWT_SECRET="replace-with-a-long-random-string"
SESSION_COOKIE_NAME="scc_session"

# --- Admin bootstrap (only used the very first time the DB is seeded) ---
ADMIN_EMAIL_1="sachigandhi935@gmail.com"
ADMIN_EMAIL_2="jaiinneha52@gmail.com"
ADMIN_TEMP_PASSWORD="12345678"

# --- Image storage (choose one) ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# or Supabase Storage
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# or AWS S3
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""
AWS_REGION=""

# --- Payments (optional, for real gateway integration later) ---
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# --- App ---
PORT=3000
NODE_ENV="development"
